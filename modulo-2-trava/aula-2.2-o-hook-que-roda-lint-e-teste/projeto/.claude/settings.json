{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-gate.sh post-edit",
            "timeout": 120,
            "statusMessage": "quality gate: conferindo o arquivo editado"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quality-gate.sh stop",
            "timeout": 600,
            "statusMessage": "quality gate: testes dos arquivos editados"
          }
        ]
      }
    ]
  }
}
